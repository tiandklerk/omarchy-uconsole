#!/bin/bash
# Gate the uConsole speaker amplifier on actual audio activity.
#
# The amp enable line (GPIO11) is driven high at boot by `gpio=11=op,dh` in
# config.txt, because without it the speaker is silent. Leaving it high means
# the amp is always powered and always amplifying whatever is on its input -
# which on this board includes supply noise that gets worse as the battery sags.
# Hence the well-known hiss and crackle, most obvious below ~10% charge.
#
# Software cannot clean up an analogue rail. What it can do is not amplify
# silence: hold the amp off while nothing is playing, and switch it on when
# something is. Idle hiss then disappears entirely, at any charge level.
#
# Playback state comes from ALSA rather than PipeWire, so this works regardless
# of which sound server is in use and needs no session bus.
set -uo pipefail

HOLD_OFF=3                       # seconds of silence before powering the amp down
POLL=1

# Resolve GPIO11's sysfs number from the pinctrl-rp1 chip's base, rather than
# parsing /sys/kernel/debug/gpio.
#
# THIS IS THE FIX for a bug that made this service silently do nothing on
# every boot since it was written: /sys/kernel/debug/gpio is root-only
# (mode 0400), and even running as root under systemd, the label-text match
# against it never succeeded, so find_gpio always failed and the script exited
# via the "leaving amp as-is" path - meaning the amp stayed permanently
# enabled exactly as before this feature existed.
#
# pinctrl-rp1's gpiochip base + offset 11 IS the RP1 GPIO11 line: the RP1
# pinctrl driver numbers its lines 0-53 matching the physical GPIO numbers
# directly, and /sys/class/gpio/gpiochip*/base and label are world-readable,
# so this needs no root and no debugfs.
find_gpio() {
  local chip base
  for chip in /sys/class/gpio/gpiochip*; do
    [[ -f "$chip/label" ]] || continue
    grep -qi "pinctrl-rp1" "$chip/label" 2>/dev/null || continue
    base=$(cat "$chip/base" 2>/dev/null) || continue
    [[ "$base" =~ ^[0-9]+$ ]] && echo $(( base + 11 )) && return 0
  done
  return 1
}

GPIO=$(find_gpio) || { echo "cannot locate GPIO11 via pinctrl-rp1; leaving amp as-is" >&2; exit 0; }
SYS=/sys/class/gpio/gpio$GPIO

setup() {
  [[ -d "$SYS" ]] || echo "$GPIO" > /sys/class/gpio/export 2>/dev/null
  [[ -d "$SYS" ]] || return 1
  echo out > "$SYS/direction" 2>/dev/null
}
amp() { echo "$1" > "$SYS/value" 2>/dev/null; }

setup || { echo "cannot control gpio$GPIO; leaving amp enabled" >&2; exit 0; }

# Anything actively playing on any card counts.
playing() {
  grep -qs "^state: RUNNING" /proc/asound/card*/pcm*p/sub*/status
}

amp 0                     # start quiet
last_active=0
while true; do
  if playing; then
    (( last_active )) || amp 1
    last_active=$(( $(date +%s) ))
  elif (( last_active )) && (( $(date +%s) - last_active >= HOLD_OFF )); then
    amp 0
    last_active=0
  fi
  sleep "$POLL"
done
