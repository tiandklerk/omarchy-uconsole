[Unit]
Description=Gate the uConsole speaker amplifier on audio activity
Documentation=https://forum.clockworkpi.com/t/uconsole-cm5-hissing-crackling-noises-when-moving-the-mouse-clicking-or-screen-refresh-bookworm-kernel-6-12-battery-powered/18966
After=sound.target
Wants=sound.target

[Service]
Type=simple
ExecStart=/usr/local/bin/uconsole-audio-amp
# If this dies, leave the amp ON rather than silent - a hiss is better than a
# device that appears to have lost its speaker. Same base+offset lookup as the
# main script; NOT the debugfs-based one, which is root-only and was the bug.
ExecStopPost=/bin/sh -c 'for c in /sys/class/gpio/gpiochip*; do grep -qi "pinctrl-rp1" "$c/label" 2>/dev/null || continue; b=$(cat "$c/base" 2>/dev/null); [ -n "$b" ] && n=$((b+11)) && echo 1 > /sys/class/gpio/gpio$n/value 2>/dev/null; done; true'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
