# omarchy-uconsole build configuration
# Sourced by every stage. Override any value via the environment.

# ---- Target hardware -------------------------------------------------------
# The uConsole carrier board with a Raspberry Pi Compute Module 5.
UC_MODEL="${UC_MODEL:-cm5}"            # cm5 | cm4 (cm4 is best-effort, untested)
UC_DEFCONFIG_cm5="bcm2712_defconfig"
UC_DEFCONFIG_cm4="bcm2711_defconfig"

# ---- Kernel ----------------------------------------------------------------
# Rex's (ak-rex) downstream Raspberry Pi tree. This is the only tree that
# carries the ClockworkPi uConsole CM5 device-tree overlay and the out-of-tree
# panel / keyboard / PMIC drivers in-tree. See docs/02-hardware.md.
KERNEL_REPO="${KERNEL_REPO:-https://github.com/ak-rex/rpi-linux.git}"
KERNEL_BRANCH="${KERNEL_BRANCH:-rpi-6.12.y}"
KERNEL_LOCALVERSION="${KERNEL_LOCALVERSION:--uconsole-${UC_MODEL}}"
# Name of the kernel image the RPi bootloader will load (see overlay/boot/config.txt)
KERNEL_IMAGE_NAME="${KERNEL_IMAGE_NAME:-kernel8-uconsole.img}"

# ---- Base distro -----------------------------------------------------------
# Arch Linux ARM aarch64 generic rootfs. We supply our own kernel and our own
# Raspberry Pi firmware, so we deliberately do NOT use the rpi-flavoured
# tarball (its linux-rpi package would fight ours).
ALARM_TARBALL="${ALARM_TARBALL:-http://os.archlinuxarm.org/os/ArchLinuxARM-aarch64-latest.tar.gz}"

# ---- Omarchy ---------------------------------------------------------------
# NOTE: Omarchy's default branch is `quattro` (v4). `master` is the stale v3
# line and, unlike quattro, still refuses to install on non-x86_64.
OMARCHY_REPO="${OMARCHY_REPO:-https://github.com/basecamp/omarchy.git}"
# Pinned to the release tag that omarchy-pkgs' `omarchy` PKGBUILD builds from,
# so the package lists we triage are the ones that actually get installed.
# `quattro` (the default branch) moves ahead of the packaged release.
OMARCHY_REF="${OMARCHY_REF:-v4.0.1}"
OMARCHY_PKGS_REPO="${OMARCHY_PKGS_REPO:-https://github.com/omacom-io/omarchy-pkgs.git}"
# Upstream publishes an aarch64 pacman repo, but as of 2026-08-25 it contains
# exactly one package (omarchy-keyring). We build the rest ourselves.
OMARCHY_AARCH64_REPO_URL="${OMARCHY_AARCH64_REPO_URL:-https://pkgs.omarchy.org/aarch64}"

# Give up on a single package after this long. Emulated builds of large C++
# trees can run for many hours; without a cap one package can consume an entire
# overnight run. Abandoned packages are reported, not silently dropped.
PKG_TIMEOUT="${PKG_TIMEOUT:-5400}"

# ---- Image -----------------------------------------------------------------
IMG_NAME="${IMG_NAME:-omarchy-uconsole-${UC_MODEL}}"
# "auto" sizes the image from the finished rootfs plus headroom. A fixed value
# (in MiB) is honoured if given, but must be large enough to hold the rootfs.
IMG_SIZE_MB="${IMG_SIZE_MB:-auto}"
IMG_HEADROOM_MB="${IMG_HEADROOM_MB:-1536}"  # free space left in the shipped image
BOOT_SIZE_MB="${BOOT_SIZE_MB:-512}"    # FAT32 firmware partition
IMG_COMPRESS="${IMG_COMPRESS:-xz}"     # xz | none

# ---- First-boot identity ---------------------------------------------------
# Omarchy provisions the real user interactively on first boot. This is only
# the fallback/maintenance account.
DEFAULT_USER="${DEFAULT_USER:-alarm}"
DEFAULT_PASS="${DEFAULT_PASS:-alarm}"
DEFAULT_HOSTNAME="${DEFAULT_HOSTNAME:-uconsole}"
DEFAULT_TZ="${DEFAULT_TZ:-Etc/UTC}"
DEFAULT_LOCALE="${DEFAULT_LOCALE:-en_US.UTF-8}"

# ---- Build machinery -------------------------------------------------------
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CACHE_DIR="${CACHE_DIR:-$ROOT_DIR/.cache}"
WORK_DIR="${WORK_DIR:-$ROOT_DIR/work}"
OUT_DIR="${OUT_DIR:-$ROOT_DIR/out}"
JOBS="${JOBS:-$(nproc)}"

# Container images used per stage.
IMG_CROSS="${IMG_CROSS:-omarchy-uconsole/cross:latest}"       # x86_64 + aarch64 cross toolchain
IMG_ALARM="${IMG_ALARM:-omarchy-uconsole/alarm:latest}"           # rootfs assembly (x86 host + chroot)
IMG_ALARM_BUILD="${IMG_ALARM_BUILD:-omarchy-uconsole/alarm-build:latest}"  # emulated aarch64 makepkg
