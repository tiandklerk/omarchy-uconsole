# Kernel config fragment merged on top of bcm2712_defconfig.
#
# bcm2712_defconfig (from ak-rex's tree) already enables everything the
# uConsole hardware needs: DRM_PANEL_CWU50, BACKLIGHT_OCP8178 and the AXP20X
# PMIC/battery/charger stack. This fragment only adds what Arch Linux, systemd,
# Hyprland and Docker expect and that the Raspberry Pi defconfig leaves off.

# --- pacman 7 sandbox ---
# pacman 7 confines downloads with Landlock and refuses to run without it:
# "restricting filesystem access failed because Landlock is not supported by
# the kernel". bcm2712_defconfig does not enable it, which leaves an Arch
# system unable to install anything. CONFIG_LSM must list landlock too.
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock,lockdown,yama,integrity,bpf"

# --- systemd / Arch userland ---
CONFIG_CGROUP_BPF=y
CONFIG_USER_NS=y
CONFIG_FANOTIFY=y
CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CHECKPOINT_RESTORE=y

# --- containers (Omarchy ships and enables Docker) ---
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
CONFIG_BRIDGE=m
CONFIG_VETH=m
CONFIG_VXLAN=m
CONFIG_MACVLAN=m
CONFIG_IPVLAN=m
CONFIG_BRIDGE_NETFILTER=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MATCH_IPVS=m
CONFIG_NF_NAT=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP_VS=m

# --- memory compression (Omarchy enables zram/zswap by default) ---
CONFIG_ZRAM=m
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y

# --- filesystems Arch tooling assumes ---
CONFIG_SQUASHFS=m
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_BTRFS_FS=m
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

# --- ufw / Omarchy firewall ---
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_MATCH_RECENT=m
CONFIG_IP_NF_TARGET_REJECT=m

# --- uinput: wtype / ydotool style input synthesis used by Omarchy ---
CONFIG_INPUT_UINPUT=y
